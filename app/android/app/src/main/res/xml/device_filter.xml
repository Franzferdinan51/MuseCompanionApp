<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- USB mass storage (flash drives): class 8, subclass 6 (SCSI transparent),
         protocol 80 (bulk-only). Lets the app handle USB drives on attach. -->
    <usb-device class="8" subclass="6" protocol="80" />

    <!-- Generic USB serial: CDC-ACM class devices (most USB serial gear). -->
    <usb-device class="2" subclass="2" protocol="1" />
    <!-- Common USB-serial chips, by vendor/product id. -->
    <usb-device vendor-id="9025" product-id="67" />
    <usb-device vendor-id="9025" product-id="1" />
    <usb-device vendor-id="4292" product-id="60000" />
    <usb-device vendor-id="6790" product-id="29987" />
    <usb-device vendor-id="1027" product-id="24577" />
    <usb-device vendor-id="1659" product-id="8963" />
</resources>
